<?xml version="1.0"?>
<launch>
  <!-- Configuration files and optional nodes. -->
  <arg name="params_file"
       default="$(find-pkg-share gl5_driver)/config/gl5.yaml"/>
  <arg name="rviz" default="true"/>
  <arg name="obstacles" default="true"/>
  <arg name="obstacle_params_file"
       default="$(env GL5_OBSTACLE_PARAMS_FILE $(find-pkg-share gl5_detection)/config/obstacles.yaml)"/>
  <!-- Preserve the original default: gl5_region.json in the working directory. -->
  <arg name="region_file"
       default="$(env GL5_REGION_FILE $(eval &quot;__import__('os').path.join(__import__('os').getcwd(), 'gl5_region.json')&quot;))"/>

  <!-- Stop the whole launch if the sensor driver exits. -->
  <node pkg="gl5_driver" exec="gl5_node" name="gl5_node"
        output="screen" on_exit="shutdown">
    <param from="$(var params_file)"/>
  </node>

  <!-- Region editing, obstacle detection and tracking. -->
  <node pkg="gl5_detection" exec="gl5_obstacle_node" name="gl5_obstacle_detector"
        output="screen" if="$(var obstacles)">
    <param from="$(var obstacle_params_file)"/>
    <param name="region_file" value="$(var region_file)"/>
  </node>

  <!-- Point cloud, region and obstacle visualization. -->
  <node pkg="rviz2" exec="rviz2" name="gl5_rviz"
        output="screen" if="$(var rviz)"
        args="-d $(find-pkg-share gl5_bringup)/rviz/gl5.rviz"/>
</launch>
